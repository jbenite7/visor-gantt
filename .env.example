# Visor Gantt - Environment Variables
# Copy this file to .env and update the values

# =============================================================================
# MPP Parser Service
# =============================================================================

# Path to MPXJ JAR file (required)
MPXJ_JAR_PATH=/app/libs/mpxj.jar

# MPXJ subprocess timeout in seconds (default: 30)
MPXJ_TIMEOUT=30

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# =============================================================================
# Database (PostgreSQL)
# =============================================================================

# Database name
POSTGRES_DB=visormpp

# Database user
POSTGRES_USER=visoruser

# Database password (CHANGE IN PRODUCTION!)
POSTGRES_PASSWORD=visorpass

# =============================================================================
# pgAdmin (Optional)
# =============================================================================

# pgAdmin default email
PGADMIN_DEFAULT_EMAIL=admin@example.com

# pgAdmin default password (CHANGE IN PRODUCTION!)
PGADMIN_DEFAULT_PASSWORD=admin123
