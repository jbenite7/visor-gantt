# Visor Gantt - Environment Variables
# Copy this file to .env and update the values

# =============================================================================
# MPP Parser Service
# =============================================================================

# MPXJ subprocess timeout in seconds (default: 30)
MPXJ_TIMEOUT=30

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Frontend-to-parser base URL inside Docker Compose
NEXT_PUBLIC_MPP_PARSER_URL=http://mpp-parser:8000

# =============================================================================
# Database (PostgreSQL)
# =============================================================================

# Database name
POSTGRES_DB=visormpp

# Database user
POSTGRES_USER=visoruser

# Database password (CHANGE IN PRODUCTION!)
POSTGRES_PASSWORD=visorpass

# Frontend database connection string inside Docker Compose
DATABASE_URL=postgresql://visoruser:visorpass@db:5432/visormpp

# =============================================================================
# pgAdmin (Optional)
# =============================================================================

# pgAdmin default email
PGADMIN_DEFAULT_EMAIL=admin@example.com

# pgAdmin default password (CHANGE IN PRODUCTION!)
PGADMIN_DEFAULT_PASSWORD=admin123
