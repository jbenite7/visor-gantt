# Visor Gantt - Environment Variables
# Copy this file to .env and update the values

# =============================================================================
# MPP Parser Service
# =============================================================================

# MPXJ subprocess timeout in seconds (default: 30)
MPXJ_TIMEOUT=30

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Frontend-to-parser base URL inside Docker Compose
NEXT_PUBLIC_MPP_PARSER_URL=http://mpp-parser:8000

# Parser base URL used by the server route
MPP_PARSER_URL=http://mpp-parser:8000

# =============================================================================
# Database (PostgreSQL)
# =============================================================================

# Database name
POSTGRES_DB=visormpp

# Database user
POSTGRES_USER=visoruser

# Database password (CHANGE IN PRODUCTION!)
POSTGRES_PASSWORD=visorpass

# Frontend database connection string inside Docker Compose
DATABASE_URL=postgresql://visoruser:visorpass@db:5432/visormpp

# Initial admin user for a clean deployment
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=admin123

# =============================================================================
# pgAdmin (Optional)
# =============================================================================

# pgAdmin default email
PGADMIN_DEFAULT_EMAIL=admin@example.com

# pgAdmin default password (CHANGE IN PRODUCTION!)
PGADMIN_DEFAULT_PASSWORD=admin123

# =============================================================================
# Credenciales (revisado el 2026-08-10)
# =============================================================================

# La contraseña de Postgres. Antes estaba escrita literal en docker-compose.yml
# mientras DATABASE_URL sí se interpolaba: cambiarla aquí no hacía nada.
POSTGRES_DB=visormpp
POSTGRES_USER=visoruser
POSTGRES_PASSWORD=visorpass

# ATENCIÓN: cambiar esta variable NO cambia la contraseña de una base que ya
# existe. Postgres solo la aplica al crear el volumen por primera vez. Para
# rotarla en un servidor en marcha hay que hacerlo dentro de la base
# (ALTER USER ... PASSWORD ...) y actualizar aquí y en DATABASE_URL. Eso es una
# operación del dueño del servidor, no de la aplicación.

# Sin valor por defecto: el arranque falla si no está. Desde que el admin ve y
# edita cualquier proyecto, un `admin123` por omisión es la llave maestra.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# pgAdmin ya no se levanta por defecto. Para usarlo:
#   docker compose --profile admin up
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Modo de prueba: abre sesión en una cuenta de revisión sin escribir ninguna
# contraseña, para poder mirar en navegador las vistas que exigen cuenta.
#
# DÉJALA VACÍA. Solo `1` exacto la enciende, y encendida `/api/modo-prueba` abre
# sesión a quien la visite. En un servidor de producción esto es una puerta
# abierta; en una máquina de desarrollo es la única forma de revisar Gantt con
# cuenta, Matriz, Ejecutivo y Cortes sin escribir credenciales reales.
VISOR_TEST_MODE=
